[
  // -------------------------------------------------------------
  // TOP BAR (3 Slim Floating Islands - Space Efficient)
  // -------------------------------------------------------------
  {
    "name": "topbar",
    "layer": "top",
    "position": "top",
    "height": 24,
    "margin-top": 4,
    "margin-bottom": 0,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 0,
    "modules-left": [
      "custom/arch"
    ],
    "modules-center": [
      "custom/scroll_lpad",
      "hyprland/workspaces",
      "custom/scroll_rpad"
    ],
    "modules-right": [
      "cpu",
      "memory",
      "network",
      "pulseaudio",
      "clock"
    ],
    "custom/arch": {
      "format": "<span color='#5dbbfa' font='12'>󰣇</span> Hyprland",
      "on-click": "python3 /home/elitex/.config/stark-rice/stark_launcher.py --toggle",
      "on-scroll-up": "/home/elitex/.local/bin/hypr-workspace-scroll next",
      "on-scroll-down": "/home/elitex/.local/bin/hypr-workspace-scroll prev",
      "tooltip": false
    },
    "custom/scroll_lpad": {
      "format": " ",
      "tooltip": false,
      "on-scroll-up": "/home/elitex/.local/bin/hypr-workspace-scroll next",
      "on-scroll-down": "/home/elitex/.local/bin/hypr-workspace-scroll prev"
    },
    "custom/scroll_rpad": {
      "format": " ",
      "tooltip": false,
      "on-scroll-up": "/home/elitex/.local/bin/hypr-workspace-scroll next",
      "on-scroll-down": "/home/elitex/.local/bin/hypr-workspace-scroll prev"
    },
    "hyprland/workspaces": {
      "format": "{id}",
      "on-click": "activate",
      "all-outputs": true,
      "persistent-workspaces": {
        "*": 5
      },
      "on-scroll-up": "/home/elitex/.local/bin/hypr-workspace-scroll next",
      "on-scroll-down": "/home/elitex/.local/bin/hypr-workspace-scroll prev",
      "on-scroll-left": "/home/elitex/.local/bin/hypr-workspace-scroll prev",
      "on-scroll-right": "/home/elitex/.local/bin/hypr-workspace-scroll next"
    },
    "cpu": {
      "interval": 2,
      "format": " {usage}%",
      "tooltip": true,
      "on-scroll-up": "/home/elitex/.local/bin/hypr-workspace-scroll next",
      "on-scroll-down": "/home/elitex/.local/bin/hypr-workspace-scroll prev"
    },
    "memory": {
      "interval": 2,
      "format": "󰍛 {used:0.1f}G / {total:0.0f}G",
      "tooltip": true,
      "on-scroll-up": "/home/elitex/.local/bin/hypr-workspace-scroll next",
      "on-scroll-down": "/home/elitex/.local/bin/hypr-workspace-scroll prev"
    },
    "network": {
      "interval": 2,
      "format-wifi": "󰤨",
      "format-ethernet": "󰈀",
      "format-disconnected": "󰤮",
      "tooltip-format": "{ifname}: {ipaddr}",
      "on-scroll-up": "/home/elitex/.local/bin/hypr-workspace-scroll next",
      "on-scroll-down": "/home/elitex/.local/bin/hypr-workspace-scroll prev"
    },
    "pulseaudio": {
      "format": "{icon}",
      "format-muted": "󰝟",
      "format-icons": {
        "default": ["󰕾", "󰖀", "󰕾"]
      },
      "on-click": "pavucontrol",
      "tooltip": false
    },
    "clock": {
      "format": "{:%H:%M}",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "on-scroll-up": "/home/elitex/.local/bin/hypr-workspace-scroll next",
      "on-scroll-down": "/home/elitex/.local/bin/hypr-workspace-scroll prev"
    }
  },

  // -------------------------------------------------------------
  // LEFT DOCK (Floating Vertical Capsule)
  // -------------------------------------------------------------
  {
    "name": "leftdock",
    "layer": "top",
    "position": "left",
    "width": 44,
    "margin-top": 54,
    "margin-bottom": 50,
    "margin-left": 10,
    "margin-right": 0,
    "spacing": 0,
    "modules-center": [
      "custom/dock_menu",
      "custom/dock_cli",
      "custom/dock_files",
      "custom/dock_brave",
      "custom/dock_discord",
      "custom/dock_vscode",
      "custom/dock_music",
      "custom/dock_div",
      "group/dock_volume",
      "idle_inhibitor#dock"
    ],
    "custom/dock_menu": {
      "format": "󰀻",
      "on-click": "python3 /home/elitex/.config/stark-rice/stark_launcher.py --toggle",
      "tooltip": true,
      "tooltip-format": "Applications (Stark Launcher)"
    },
    "custom/dock_cli": {
      "format": "󰞷",
      "on-click": "kitty -e /home/elitex/.local/bin/agy",
      "tooltip": true,
      "tooltip-format": "Antigravity CLI"
    },
    "custom/dock_files": {
      "format": "󰉋",
      "on-click": "thunar",
      "tooltip": true,
      "tooltip-format": "File Manager (Thunar)"
    },
    "custom/dock_brave": {
      "format": "",
      "on-click": "brave",
      "tooltip": true,
      "tooltip-format": "Brave Browser"
    },
    "custom/dock_discord": {
      "format": "󰙯",
      "on-click": "discord",
      "tooltip": true,
      "tooltip-format": "Discord"
    },
    "custom/dock_vscode": {
      "format": "󰨞",
      "on-click": "code",
      "tooltip": true,
      "tooltip-format": "Visual Studio Code"
    },
    "custom/dock_music": {
      "format": "󰓇",
      "on-click": "python3 /home/elitex/.config/stark-rice/stark_spotify.py --toggle",
      "tooltip": true,
      "tooltip-format": "Zenify Music Player"
    },
    "custom/dock_div": {
      "format": "―",
      "tooltip": false
    },
    "group/dock_volume": {
      "orientation": "inherit",
      "drawer": {
        "transition-duration": 300,
        "children-class": "dock-vol-slider",
        "transition-left-to-right": false
      },
      "modules": [
        "pulseaudio#dock",
        "pulseaudio/slider#dock"
      ]
    },
    "pulseaudio#dock": {
      "format": "{icon}",
      "format-muted": "󰝟",
      "format-icons": {
        "default": ["󰕿", "󰖀", "󰕾"]
      },
      "scroll-step": 5,
      "on-click": "pavucontrol",
      "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle || pactl set-sink-mute @DEFAULT_SINK@ toggle",
      "tooltip": true,
      "tooltip-format": "Volume: {volume}%\nScroll to adjust"
    },
    "pulseaudio/slider#dock": {
      "min": 0,
      "max": 100,
      "orientation": "vertical"
    },
    "idle_inhibitor#dock": {
      "format": "{icon}",
      "format-icons": {
        "activated": "",
        "deactivated": "󰒲"
      },
      "tooltip": true,
      "tooltip-format-activated": "Caffeine: Active (Awake)",
      "tooltip-format-deactivated": "Caffeine: Inactive (Normal sleep)"
    }
  }
]
